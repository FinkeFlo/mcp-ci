{
  "name": "mcp-ci",
  "version": "0.1.0",
  "description": "MCP server for SAP Cloud Integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-ci": "dist/index.js"
  },
  "files": [
    "dist",
    "config/tenants.example.jsonc"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "tsx scripts/coverage/cli.ts",
    "schema-budget": "tsx scripts/schema-budget/cli.ts",
    "test:eval": "tsx scripts/evals/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "mcpServer": {
    "command": "npx",
    "args": [
      "-y",
      "github:FinkeFlo/mcp-ci#v0.1.0"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "js-yaml": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
