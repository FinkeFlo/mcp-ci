{
  "name": "mcp-ci",
  "version": "0.1.0",
  "description": "MCP server for SAP Cloud Integration",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "tsx scripts/coverage/cli.ts"
