    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "js-yaml": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
