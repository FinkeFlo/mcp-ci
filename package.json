    "@types/node": "^25.5.0",
    "fast-xml-parser": "^5.5.9",
    "js-yaml": "^5.1.0",
    "jszip": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
